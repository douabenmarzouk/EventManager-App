<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion.evenements.ui.ReportsStatsController">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              style="-fx-background-color: #111827; -fx-padding: 12;">
            <Label text="Rapports et Statistiques"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="Vue analytique"
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #020617; -fx-background-color: #020617;">
            <content>
                <VBox spacing="18"
                      style="-fx-background-color: #0F172A; -fx-padding: 20;">

                    <!-- FILTRES -->
                    <HBox spacing="10"
                          alignment="CENTER_LEFT">
                        <Label text="Filtrer par année :"
                               style="-fx-text-fill: #E5E7EB;"/>
                        <ComboBox fx:id="comboAnnee"
                                  promptText="Sélectionner une année"
                                  prefWidth="160"/>
                        <Label text="Filtrer par association :"
                               style="-fx-text-fill: #E5E7EB;"/>
                        <ComboBox fx:id="comboAssociation"
                                  promptText="Toutes les associations"
                                  prefWidth="220"/>
                        <Button text="Actualiser"
                                fx:id="btnActualiser"
                                onAction="#rafraichirDonnees"
                                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 6;"/>
                    </HBox>

                    <!-- LIGNE 1 : CARTES KPI -->
                    <HBox spacing="16">
                        <VBox spacing="6"
                              prefWidth="220"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Total membres"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelTotalMembres"
                                   text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 26; -fx-font-weight: bold;"/>
                            <Label text="Sur la période sélectionnée"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>

                        <VBox spacing="6"
                              prefWidth="220"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Membres actifs"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelMembresActifs"
                                   text="0"
                                   style="-fx-text-fill: #22C55E; -fx-font-size: 26; -fx-font-weight: bold;"/>
                            <Label text="Cotisation payée et statut ACTIF"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>

                        <VBox spacing="6"
                              prefWidth="220"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Cotisations totales (€)"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelTotalCotisations"
                                   text="0.00"
                                   style="-fx-text-fill: #FACC15; -fx-font-size: 26; -fx-font-weight: bold;"/>
                            <Label text="Somme des paiements reçus"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>

                        <VBox spacing="6"
                              prefWidth="240"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Associations actives"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelAssociationsActives"
                                   text="0"
                                   style="-fx-text-fill: #60A5FA; -fx-font-size: 26; -fx-font-weight: bold;"/>
                            <Label text="Toujours en activité"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>
                    </HBox>

                    <!-- LIGNE 2 : GRAPHIQUES -->
                    <HBox spacing="16">

                        <!-- Pie Chart : répartition des statuts -->
                        <VBox spacing="10"
                              prefWidth="420"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Répartition des membres par statut"
                                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

                            <PieChart fx:id="pieStatuts"
                                      prefHeight="250"
                                      labelsVisible="true"
                                      legendSide="BOTTOM"/>
                        </VBox>

                        <!-- Bar Chart : cotisations par association -->
                        <VBox spacing="10"
                              prefWidth="500"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Cotisations par association (€)"
                                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

                            <BarChart fx:id="barCotisations"
                                      prefHeight="250">
                                <xAxis>
                                    <CategoryAxis fx:id="xAxisAssoc" label="Association"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="yAxisMontant" label="Montant (€)"/>
                                </yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>

                    <!-- LIGNE 3 : TABLEAU DETAILLE -->
                    <VBox spacing="10"
                          style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                        <Label text="Détail des cotisations par membre"
                               style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

                        <TableView fx:id="tableCotisations"
                                   prefHeight="260">
                            <columns>
                                <TableColumn fx:id="colIdMembre"
                                             text="ID"
                                             prefWidth="60"/>
                                <TableColumn fx:id="colNomMembre"
                                             text="Nom"
                                             prefWidth="130"/>
                                <TableColumn fx:id="colPrenomMembre"
                                             text="Prénom"
                                             prefWidth="130"/>
                                <TableColumn fx:id="colAssociation"
                                             text="Association"
                                             prefWidth="160"/>
                                <TableColumn fx:id="colMontant"
                                             text="Montant (€)"
                                             prefWidth="110"/>
                                <TableColumn fx:id="colDatePaiement"
                                             text="Date paiement"
                                             prefWidth="120"/>
                                <TableColumn fx:id="colStatutMembre"
                                             text="Statut"
                                             prefWidth="90"/>
                            </columns>
                        </TableView>

                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Button text="Exporter en PDF"
                                    fx:id="btnExportPdf"
                                    onAction="#exporterPdf"
                                    style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-background-radius: 6;"/>
                            <Button text="Exporter en Excel"
                                    fx:id="btnExportExcel"
                                    onAction="#exporterExcel"
                                    style="-fx-background-color: #22C55E; -fx-text-fill: white; -fx-background-radius: 6;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
