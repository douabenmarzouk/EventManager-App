<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.evenements.controller.PayCotisationController"
            style="-fx-background: linear-gradient(to bottom, #667eea, #764ba2);">

    <center>
        <VBox alignment="CENTER" maxWidth="360" spacing="8"
              style="-fx-background: white; -fx-background-radius: 16;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0.4, 0, 4);">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <!-- Titre + montant -->
            <Label text="Payer la Cotisation"
                   style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="cotisationAmount" text="50 €"
                   style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>

            <!-- Mini carte simulée -->
            <StackPane style="-fx-background: linear-gradient(135deg, #667eea, #764ba2);
                              -fx-background-radius: 10; -fx-padding: 10 12;">
                <VBox spacing="4">
                    <Label text="•••• •••• •••• 4242" style="-fx-font-size: 13; -fx-text-fill: white;"/>
                    <HBox>
                        <Label fx:id="cardHolderPreview" text="VOTRE NOM"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="12/27" style="-fx-text-fill: white; -fx-font-size: 11;"/>
                    </HBox>
                </VBox>
            </StackPane>

            <!-- Formulaire compact -->
            <VBox spacing="6">
                <TextField fx:id="cardNumber" promptText="Numéro de carte"
                           style="-fx-background-radius: 8; -fx-padding: 8;"
                           onKeyReleased="#updateCardPreview"/>
                <TextField fx:id="cardHolder" promptText="Titulaire"
                           style="-fx-background-radius: 8; -fx-padding: 8;"
                           onKeyReleased="#updateCardPreview"/>
                <HBox spacing="6">
                    <TextField fx:id="cardExpiry" promptText="MM/AA" prefWidth="95"
                               style="-fx-background-radius: 8; -fx-padding: 8;"/>
                    <PasswordField fx:id="cardCVV" promptText="CVV" prefWidth="75"
                                   style="-fx-background-radius: 8; -fx-padding: 8;"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button text="Annuler" onAction="#cancelPayment"
                            style="-fx-padding: 6 12; -fx-background-radius: 8;"/>
                    <Button text="Payer 50 €" onAction="#handlePayCotisation"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-padding: 8 20; -fx-font-size: 12;"/>
                </HBox>
            </VBox>

            <!-- Succès compact -->
            <VBox fx:id="paymentStatusBox" visible="false" spacing="4" alignment="CENTER"
                  style="-fx-background: #d4edda; -fx-background-radius: 10; -fx-padding: 12;">
                <Label text="Paiement accepté !"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #155724;"/>
                <Label text="Cotisation à jour" style="-fx-font-size: 12; -fx-text-fill: #155724;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
