<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion.evenements.controller.AccueilProController"
            style="-fx-background-color: #0B0F1A;"
            prefWidth="1200" prefHeight="740"
            maxWidth="1200" maxHeight="740"
            minWidth="1200" minHeight="740">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background: linear-gradient(to right, #111827 0%, #1F2937 100%);
                     -fx-padding: 12 40;
                     -fx-border-color: #3B82F6;
                     -fx-border-width: 0 0 2 0;">
            <Label text="⚡" style="-fx-font-size: 24;"/>
            <Label text="EventManager"
                   style="-fx-font-size: 22; -fx-font-weight: 900; -fx-text-fill: #60A5FA;"/>
            <Label text="Gestion intelligente des événements"
                   style="-fx-font-size: 11; -fx-text-fill: #A5F3FC; -fx-opacity: 0.85;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Se connecter" onAction="#goToLogin"
                    style="-fx-background-color: linear-gradient(to right, #3B82F6, #2563EB);
                           -fx-text-fill: white; -fx-font-weight: 600;
                           -fx-padding: 8 24; -fx-background-radius: 14; -fx-font-size: 11;
                           -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 28 40 28 40;
                                                              -fx-background: linear-gradient(to bottom right, #1E1B4B 0%, #0F172A 100%);
                                                              -fx-fill-height: true;">

                <!-- TITRE PRINCIPAL -->
                <VBox spacing="4" alignment="CENTER">
                    <Label text="La plateforme tout-en-un pour vos événements"
                           style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: white;"/>
                    <Label text="et associations"
                           style="-fx-font-size: 32; -fx-font-weight: 900; -fx-text-fill: #8B5CF6;"/>
                    <Label text="Créez • Organisez • Gérez • Simplifiez"
                           style="-fx-font-size: 12; -fx-text-fill: #CBD5E1; -fx-font-weight: 600;"/>
                </VBox>

                <!-- DEUX CARTES HORIZONTALES -->
                <VBox spacing="16" alignment="CENTER" style="-fx-padding: 0;">

                    <!-- CARTE MEMBRE -->
                    <HBox spacing="0" alignment="CENTER_LEFT" onMouseClicked="#goToLoginMembre"
                          style="-fx-cursor: hand;
                                  -fx-background-color: linear-gradient(to right, #1E293B 0%, #0F172A 100%);
                                  -fx-background-radius: 18;
                                  -fx-border-color: rgba(16, 185, 129, 0.3);
                                  -fx-border-width: 2;
                                  -fx-border-radius: 18;
                                  -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.2), 30, 0.4, 0, 12);
                                  -fx-pref-height: 160;">

                        <!-- Côté gauche - Icône -->
                        <StackPane style="-fx-pref-width: 200; -fx-background-color: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05));
                                          -fx-background-radius: 18 0 0 18;">
                            <Label text="👤" style="-fx-font-size: 80; -fx-opacity: 0.2;"/>
                            <Label text="👤" style="-fx-font-size: 64;"/>
                        </StackPane>

                        <!-- Côté droit - Contenu -->
                        <VBox spacing="10" alignment="TOP_LEFT" style="-fx-padding: 24 24 24 28; -fx-pref-width: 550;">

                            <VBox spacing="4">
                                <Label text="Espace Membre" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #10B981;"/>
                                <Label text="Accédez à tous les services de votre association en quelques clics"
                                       style="-fx-font-size: 11; -fx-text-fill: #A5F3FC; -fx-wrap-text: true;"/>
                            </VBox>

                            <VBox spacing="8" alignment="TOP_LEFT">
                                <Label text="✓ Consultez vos événements à venir" style="-fx-font-size: 10; -fx-text-fill: #E2E8F0; -fx-font-weight: 500;"/>
                                <Label text="✓ Payez votre cotisation en ligne de façon sécurisée" style="-fx-font-size: 10; -fx-text-fill: #E2E8F0; -fx-font-weight: 500;"/>
                                <Label text="✓ Suivez votre présence et participations" style="-fx-font-size: 10; -fx-text-fill: #E2E8F0; -fx-font-weight: 500;"/>
                            </VBox>

                            <Button text="Se connecter maintenant →" onAction="#goToLoginMembre"
                                    style="-fx-background-color: #10B981;
                                           -fx-text-fill: white; -fx-font-weight: 700;
                                           -fx-padding: 8 22; -fx-font-size: 11; -fx-background-radius: 12;
                                           -fx-cursor: hand; -fx-pref-width: 180;"/>
                        </VBox>
                    </HBox>

                    <!-- CARTE RESPONSABLE -->
                    <HBox spacing="0" alignment="CENTER_LEFT" onMouseClicked="#goToInscriptionAsso"
                          style="-fx-cursor: hand;
                                  -fx-background-color: linear-gradient(to right, #2D1B69 0%, #1a0f3a 100%);
                                  -fx-background-radius: 18;
                                  -fx-border-color: rgba(139, 92, 246, 0.3);
                                  -fx-border-width: 2;
                                  -fx-border-radius: 18;
                                  -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.2), 30, 0.4, 0, 12);
                                  -fx-pref-height: 160;">

                        <!-- Côté gauche - Icône -->
                        <StackPane style="-fx-pref-width: 200; -fx-background-color: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.05));
                                          -fx-background-radius: 18 0 0 18;">
                            <Label text="🚀" style="-fx-font-size: 80; -fx-opacity: 0.2;"/>
                            <Label text="🚀" style="-fx-font-size: 64;"/>
                        </StackPane>

                        <!-- Côté droit - Contenu -->
                        <VBox spacing="10" alignment="TOP_LEFT" style="-fx-padding: 24 24 24 28; -fx-pref-width: 550;">

                            <VBox spacing="4">
                                <Label text="Créer Espace Pro" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #A78BFA;"/>
                                <Label text="Lancez votre plateforme de gestion d'association en moins de 3 minutes"
                                       style="-fx-font-size: 11; -fx-text-fill: #A5F3FC; -fx-wrap-text: true;"/>
                            </VBox>

                            <VBox spacing="8" alignment="TOP_LEFT">
                                <Label text="✓ Création association complète et gratuite" style="-fx-font-size: 10; -fx-text-fill: #E2E8F0; -fx-font-weight: 500;"/>
                                <Label text="✓ Gestion intégrée des événements et cotisations" style="-fx-font-size: 10; -fx-text-fill: #E2E8F0; -fx-font-weight: 500;"/>
                                <Label text="✓ Administration simple de vos membres" style="-fx-font-size: 10; -fx-text-fill: #E2E8F0; -fx-font-weight: 500;"/>
                            </VBox>

                            <Button text="Créer mon espace maintenant →" onAction="#goToInscriptionAsso"
                                    style="-fx-background-color: #8B5CF6;
                                           -fx-text-fill: white; -fx-font-weight: 700;
                                           -fx-padding: 8 22; -fx-font-size: 11; -fx-background-radius: 12;
                                           -fx-cursor: hand; -fx-pref-width: 200;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- DESCRIPTION PLATEFORME -->
                <VBox spacing="14" alignment="CENTER" style="-fx-padding: 16 0;">
                    <Label text="Qu'est-ce que EventManager ?"
                           style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #60A5FA;"/>

                    <HBox spacing="22" alignment="TOP_CENTER">
                        <!-- Colonne 1 -->
                        <VBox spacing="12" style="-fx-pref-width: 240;">
                            <HBox spacing="8" alignment="TOP_LEFT">
                                <Label text="📋" style="-fx-font-size: 20;"/>
                                <VBox spacing="3">
                                    <Label text="Gestion Complète" style="-fx-font-size: 12; -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="Gérez association, membres, événements et cotisations depuis un seul endroit."
                                           style="-fx-font-size: 10; -fx-text-fill: #CBD5E1; -fx-wrap-text: true;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="8" alignment="TOP_LEFT">
                                <Label text="💳" style="-fx-font-size: 20;"/>
                                <VBox spacing="3">
                                    <Label text="Paiements Faciles" style="-fx-font-size: 12; -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="Encaissez les cotisations en ligne de façon sécurisée et instantanée."
                                           style="-fx-font-size: 10; -fx-text-fill: #CBD5E1; -fx-wrap-text: true;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="8" alignment="TOP_LEFT">
                                <Label text="📊" style="-fx-font-size: 20;"/>
                                <VBox spacing="3">
                                    <Label text="Statistiques Temps Réel" style="-fx-font-size: 12; -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="Consultez tableaux de bord et rapports détaillés instantanément."
                                           style="-fx-font-size: 10; -fx-text-fill: #CBD5E1; -fx-wrap-text: true;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Colonne 2 -->
                        <VBox spacing="12" style="-fx-pref-width: 240;">
                            <HBox spacing="8" alignment="TOP_LEFT">
                                <Label text="👥" style="-fx-font-size: 20;"/>
                                <VBox spacing="3">
                                    <Label text="Gestion Membres" style="-fx-font-size: 12; -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="Importer, gérer et communiquer avec vos membres facilement."
                                           style="-fx-font-size: 10; -fx-text-fill: #CBD5E1; -fx-wrap-text: true;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="8" alignment="TOP_LEFT">
                                <Label text="🎫" style="-fx-font-size: 20;"/>
                                <VBox spacing="3">
                                    <Label text="Événements" style="-fx-font-size: 12; -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="Créez événements, gérez inscriptions et présence automatiquement."
                                           style="-fx-font-size: 10; -fx-text-fill: #CBD5E1; -fx-wrap-text: true;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="8" alignment="TOP_LEFT">
                                <Label text="🔒" style="-fx-font-size: 20;"/>
                                <VBox spacing="3">
                                    <Label text="Sécurité Maximale" style="-fx-font-size: 12; -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="Vos données sont chiffrées et protégées conformément aux normes."
                                           style="-fx-font-size: 10; -fx-text-fill: #CBD5E1; -fx-wrap-text: true;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- ÉVÉNEMENTS À VENIR -->
                <VBox spacing="10" alignment="CENTER">
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="🎉 Événements à venir"
                               style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: #60A5FA;"/>
                        <Label text="Découvrez les prochains événements de nos associations"
                               style="-fx-font-size: 10; -fx-text-fill: #94A3B8;"/>
                    </VBox>
                    <ScrollPane fitToWidth="true" prefHeight="140" hbarPolicy="NEVER"
                                style="-fx-background: transparent; -fx-background-color: transparent;">
                        <HBox fx:id="listeEvenements" spacing="16" alignment="CENTER_LEFT"
                              style="-fx-padding: 12; -fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>

                <!-- TÉMOIGNAGES -->
                <VBox spacing="10" alignment="CENTER">
                    <Label text="⭐ Ils nous font confiance"
                           style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: #A78BFA;"/>
                    <HBox spacing="20" alignment="CENTER">
                        <VBox alignment="TOP_CENTER" spacing="8"
                              style="-fx-background-color: linear-gradient(to bottom, #1E293B, #0F172A);
                                     -fx-background-radius: 12;
                                     -fx-border-color: rgba(96, 165, 250, 0.2);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 12;
                                     -fx-padding: 16;
                                     -fx-pref-width: 250;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 16, 0.3, 0, 6);">
                            <Label text="⭐⭐⭐⭐⭐" style="-fx-font-size: 16;"/>
                            <Label text="« Enfin une appli simple et complète ! »"
                                   style="-fx-font-size: 11; -fx-text-fill: white; -fx-font-weight: 600;
                                          -fx-wrap-text: true;"/>
                            <Label text="— Association Sportive Casablanca"
                                   style="-fx-text-fill: #60A5FA; -fx-font-weight: 600; -fx-font-size: 9;"/>
                        </VBox>
                        <VBox alignment="TOP_CENTER" spacing="8"
                              style="-fx-background-color: linear-gradient(to bottom, #1E293B, #0F172A);
                                     -fx-background-radius: 12;
                                     -fx-border-color: rgba(139, 92, 246, 0.2);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 12;
                                     -fx-padding: 16;
                                     -fx-pref-width: 250;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 16, 0.3, 0, 6);">
                            <Label text="⭐⭐⭐⭐⭐" style="-fx-font-size: 16;"/>
                            <Label text="« Plus de paperasse, tout digital ! »"
                                   style="-fx-font-size: 11; -fx-text-fill: white; -fx-font-weight: 600;
                                          -fx-wrap-text: true;"/>
                            <Label text="— Club Culturel Marrakech"
                                   style="-fx-text-fill: #A78BFA; -fx-font-weight: 600; -fx-font-size: 9;"/>
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- FOOTER -->
    <bottom>
        <VBox style="-fx-background-color: #030711; -fx-border-color: #3B82F6; -fx-border-width: 2 0 0 0;">
            <HBox alignment="CENTER" style="-fx-padding: 8;">
                <Label text="© 2025 EventManager • Plus de 800 associations marocaines nous font confiance"
                       style="-fx-text-fill: #60A5FA; -fx-font-size: 10; -fx-font-weight: 600;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>