<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion.evenements.ui.AdminDashboardController">

    <!-- BARRE HAUT -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              style="-fx-background-color: #111827; -fx-padding: 12;">
            <Label text="Tableau de bord - Administrateur"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelAdminName"
                   text="Nom administrateur"
                   style="-fx-text-fill: #E5E7EB; -fx-font-size: 14;"/>
            <Label fx:id="labelNiveauAcces"
                   text="SUPER ADMIN"
                   style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-padding: 4 8 4 8; -fx-background-radius: 12; -fx-font-size: 12;"/>
        </HBox>
    </top>

    <!-- MENU GAUCHE -->
    <left>
        <VBox spacing="12"
              prefWidth="230"
              style="-fx-background-color: #020617; -fx-padding: 18;">
            <Label text="Navigation"
                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13; -fx-font-weight: bold;"/>

            <Button text="Accueil"
                    fx:id="btnAccueil"
                    onAction="#showAccueil"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #E5E7EB; -fx-alignment: CENTER_LEFT; -fx-padding: 8 12 8 12;"/>
            <Button text="Membres"
                    fx:id="btnMembres"
                    onAction="#showMembres"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #E5E7EB; -fx-alignment: CENTER_LEFT; -fx-padding: 8 12 8 12;"/>
            <Button text="Associations"
                    fx:id="btnAssociations"
                    onAction="#showAssociations"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #E5E7EB; -fx-alignment: CENTER_LEFT; -fx-padding: 8 12 8 12;"/>
            <Button text="Événements"
                    fx:id="btnEvenements"
                    onAction="#showEvenements"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #E5E7EB; -fx-alignment: CENTER_LEFT; -fx-padding: 8 12 8 12;"/>
            <Button text="Rapports et Statistiques"
                    fx:id="btnRapports"
                    onAction="#showRapports"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #E5E7EB; -fx-alignment: CENTER_LEFT; -fx-padding: 8 12 8 12;"/>

            <Pane VBox.vgrow="ALWAYS"/>

            <Button text="Déconnexion"
                    fx:id="btnLogout"
                    onAction="#logout"
                    maxWidth="Infinity"
                    style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 6;"/>
        </VBox>
    </left>

    <!-- CONTENU CENTRAL -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #020617; -fx-background-color: #020617;">
            <content>
                <VBox spacing="18"
                      style="-fx-background-color: #0F172A; -fx-padding: 20;">
                    <!-- LIGNE 1 : CARTES INDICATEURS -->
                    <HBox spacing="16">
                        <!-- Total membres -->
                        <VBox spacing="6"
                              prefWidth="220"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Total membres"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelTotalMembres"
                                   text="0"
                                   style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: bold;"/>
                            <Label text="Tous statuts confondus"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>

                        <!-- Membres actifs -->
                        <VBox spacing="6"
                              prefWidth="220"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Membres actifs"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelMembresActifs"
                                   text="0"
                                   style="-fx-text-fill: #22C55E; -fx-font-size: 28; -fx-font-weight: bold;"/>
                            <Label text="Cotisation payée et statut ACTIF"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>

                        <!-- Associations -->
                        <VBox spacing="6"
                              prefWidth="220"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Associations"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelTotalAssociations"
                                   text="0"
                                   style="-fx-text-fill: #60A5FA; -fx-font-size: 28; -fx-font-weight: bold;"/>
                            <Label text="Associations enregistrées"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>

                        <!-- Cotisations totales -->
                        <VBox spacing="6"
                              prefWidth="260"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Cotisations totales (€)"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 13;"/>
                            <Label fx:id="labelTotalCotisations"
                                   text="0.00"
                                   style="-fx-text-fill: #FACC15; -fx-font-size: 28; -fx-font-weight: bold;"/>
                            <Label text="Somme de toutes les cotisations payées"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11;"/>
                        </VBox>
                    </HBox>

                    <!-- LIGNE 2 : ACTIONS ADMIN -->
                    <HBox spacing="16">
                        <!-- Bloc inscription nouveau membre -->
                        <VBox spacing="10"
                              prefWidth="420"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Inscrire un nouveau membre"
                                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

                            <GridPane hgap="8" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>

                                <children>
                                    <TextField fx:id="txtNom"
                                               promptText="Nom"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="0"/>
                                    <TextField fx:id="txtPrenom"
                                               promptText="Prénom"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="0"/>

                                    <TextField fx:id="txtEmail"
                                               promptText="Email"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="1"/>
                                    <TextField fx:id="txtTelephone"
                                               promptText="Téléphone"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="1"/>

                                    <Button text="Inscrire"
                                            fx:id="btnInscrireMembre"
                                            onAction="#inscrireMembre"
                                            GridPane.columnIndex="0"
                                            GridPane.rowIndex="2"
                                            GridPane.columnSpan="2"
                                            maxWidth="Infinity"
                                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 0 8 0;"/>
                                </children>
                            </GridPane>
                        </VBox>

                        <!-- Bloc validation / rapport -->
                        <VBox spacing="10"
                              prefWidth="420"
                              style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                            <Label text="Actions administrateur"
                                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

                            <Label text="Valider l'inscription d'un membre (par ID)"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;"/>
                            <HBox spacing="8">
                                <TextField fx:id="txtIdMembreValidation"
                                           promptText="ID membre"
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="Valider"
                                        fx:id="btnValiderInscription"
                                        onAction="#validerInscriptionMembre"
                                        style="-fx-background-color: #22C55E; -fx-text-fill: white; -fx-background-radius: 6;"/>
                            </HBox>

                            <Separator/>

                            <Label text="Générer un rapport global"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;"/>
                            <Button text="Générer le rapport"
                                    fx:id="btnGenererRapport"
                                    onAction="#genererRapport"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-background-radius: 6;"/>
                        </VBox>
                    </HBox>

                    <!-- LIGNE 3 : TABLE DES DERNIERS MEMBRES -->
                    <VBox spacing="10"
                          style="-fx-background-color: #111827; -fx-padding: 16; -fx-background-radius: 10;">
                        <Label text="Derniers membres inscrits"
                               style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>

                        <TableView fx:id="tableDerniersMembres"
                                   prefHeight="220">
                            <columns>
                                <TableColumn fx:id="colId"
                                             text="ID"
                                             prefWidth="60"/>
                                <TableColumn fx:id="colNom"
                                             text="Nom"
                                             prefWidth="130"/>
                                <TableColumn fx:id="colPrenom"
                                             text="Prénom"
                                             prefWidth="130"/>
                                <TableColumn fx:id="colEmail"
                                             text="Email"
                                             prefWidth="200"/>
                                <TableColumn fx:id="colStatut"
                                             text="Statut"
                                             prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
