<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestion.evenements.controller.LoginController"
            style="-fx-background-color: #0B0F1A;"
            prefWidth="1200" prefHeight="740"
            maxWidth="1200" maxHeight="740"
            minWidth="1200" minHeight="740">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: #111827; -fx-padding: 16 40; -fx-border-width: 0 0 1 0; -fx-border-color: #1F2937;">
            <Label text="⚡" style="-fx-font-size: 32;"/>
            <Label text="Lightning EventManager" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #60A5FA;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Retour à l'accueil" onAction="#goToAccueil"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 13; -fx-font-weight: 600; -fx-underline: false;"/>
        </HBox>
    </top>

    <!-- CENTRE -->
    <center>
        <StackPane alignment="CENTER"
                   style="-fx-background-color: linear-gradient(to bottom right, #1E1B4B, #0F172A);">

            <ScrollPane style="-fx-background-color: transparent; -fx-fit-to-width: true;">
                <VBox alignment="TOP_CENTER" spacing="24" style="-fx-padding: 40; -fx-background-color: transparent;">

                    <!-- Titre Principal -->
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="Connexion à EventManager"
                               style="-fx-font-size: 36; -fx-font-weight: 900; -fx-text-fill: white;"/>
                        <Label text="Sélectionnez votre type de compte pour continuer"
                               style="-fx-font-size: 14; -fx-text-fill: #94A3B8;"/>
                    </VBox>

                    <!-- CONTENEUR 3 CARTES -->
                    <HBox alignment="CENTER" spacing="32" style="-fx-padding: 20;">

                        <!-- CARTE 1: MEMBRE -->
                        <VBox alignment="TOP_CENTER" spacing="24"
                              maxWidth="320" minHeight="420"
                              style="-fx-background-color: #111827;
                                     -fx-background-radius: 20;
                                     -fx-padding: 36 28;
                                     -fx-border-color: #1E293B;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 20;
                                     -fx-effect: dropshadow(gaussian, #000000AA, 30, 0.2, 0, 8);">

                            <!-- Header Carte -->
                            <VBox alignment="CENTER" spacing="12">
                                <Label text="👤" style="-fx-font-size: 44;"/>
                                <Label text="Accès Membre"
                                       style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #10B981;"/>
                                <Label text="Connectez-vous avec votre numéro de membre"
                                       style="-fx-font-size: 12; -fx-text-fill: #64748B; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                            </VBox>

                            <!-- Formulaire Membre -->
                            <VBox spacing="16" style="-fx-fill-height: true;">
                                <TextField fx:id="memberEmail"
                                           promptText="Email du membre"
                                           prefHeight="44"
                                           style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-prompt-text-fill: #64748B;
                                                  -fx-background-radius: 12; -fx-padding: 0 14; -fx-font-size: 12;
                                                  -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 12;"/>
                                <TextField fx:id="memberNumber"
                                           promptText="Numéro de membre (ex: MBR-2025-0481)"
                                           prefHeight="44"
                                           style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-prompt-text-fill: #64748B;
                                                  -fx-background-radius: 12; -fx-padding: 0 14; -fx-font-size: 12;
                                                  -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 12;"/>
                            </VBox>

                            <!-- Bouton Se Connecter -->
                            <Button text="Se connecter"
                                    onAction="#loginMember"
                                    prefWidth="260" prefHeight="44"
                                    style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: 700;
                                           -fx-background-radius: 12; -fx-font-size: 13; -fx-cursor: hand;">
                                <effect>
                                    <DropShadow color="#10B98166" radius="10"/>
                                </effect>
                            </Button>

                            <!-- Lien Mot de Passe Oublié -->
                            <Hyperlink text="Mot de passe oublié ?"
                                       style="-fx-text-fill: #60A5FA; -fx-font-size: 11; -fx-underline: true; -fx-padding: 0;"/>
                        </VBox>

                        <!-- CARTE 2: ADMIN -->
                        <VBox alignment="TOP_CENTER" spacing="24"
                              maxWidth="320" minHeight="420"
                              style="-fx-background-color: #111827;
                                     -fx-background-radius: 20;
                                     -fx-padding: 36 28;
                                     -fx-border-color: #5B21B6;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 20;
                                     -fx-effect: dropshadow(gaussian, #5B21B633, 30, 0.3, 0, 8);">

                            <!-- Header Carte -->
                            <VBox alignment="CENTER" spacing="12">
                                <Label text="🔐" style="-fx-font-size: 44;"/>
                                <Label text="Accès Admin"
                                       style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #8B5CF6;"/>
                                <Label text="Réservé aux administrateurs système"
                                       style="-fx-font-size: 12; -fx-text-fill: #64748B; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                            </VBox>

                            <!-- Formulaire Admin -->
                            <VBox spacing="16" style="-fx-fill-height: true;">
                                <TextField fx:id="adminEmail"
                                           promptText="Email professionnel"
                                           prefHeight="44"
                                           style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-prompt-text-fill: #64748B;
                                                  -fx-background-radius: 12; -fx-padding: 0 14; -fx-font-size: 12;
                                                  -fx-border-color: #5B21B6; -fx-border-width: 1; -fx-border-radius: 12;"/>
                                <PasswordField fx:id="adminPassword"
                                               promptText="Mot de passe sécurisé"
                                               prefHeight="44"
                                               style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-prompt-text-fill: #64748B;
                                                      -fx-background-radius: 12; -fx-padding: 0 14; -fx-font-size: 12;
                                                      -fx-border-color: #5B21B6; -fx-border-width: 1; -fx-border-radius: 12;"/>
                            </VBox>

                            <!-- Bouton Connexion -->
                            <Button text="Se connecter"
                                    onAction="#loginAdmin"
                                    prefWidth="260" prefHeight="44"
                                    style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-font-weight: 700;
                                           -fx-background-radius: 12; -fx-font-size: 13; -fx-cursor: hand;">
                                <effect>
                                    <DropShadow color="#8B5CF666" radius="10"/>
                                </effect>
                            </Button>

                            <!-- Lien Mot de Passe Oublié -->
                            <Hyperlink text="Besoin d'aide ?"
                                       style="-fx-text-fill: #60A5FA; -fx-font-size: 11; -fx-underline: true; -fx-padding: 0;"/>
                        </VBox>

                        <!-- CARTE 3: ASSOCIATION -->
                        <VBox alignment="TOP_CENTER" spacing="24"
                              maxWidth="320" minHeight="420"
                              style="-fx-background-color: #111827;
                                     -fx-background-radius: 20;
                                     -fx-padding: 36 28;
                                     -fx-border-color: #F59E0B;
                                     -fx-border-width: 2;
                                     -fx-border-radius: 20;
                                     -fx-effect: dropshadow(gaussian, #F59E0B33, 30, 0.3, 0, 8);">

                            <!-- Header Carte -->
                            <VBox alignment="CENTER" spacing="12">
                                <Label text="🏢" style="-fx-font-size: 44;"/>
                                <Label text="Accès Association"
                                       style="-fx-font-size: 20; -fx-font-weight: 900; -fx-text-fill: #F59E0B;"/>
                                <Label text="Gérez votre association et vos événements"
                                       style="-fx-font-size: 12; -fx-text-fill: #64748B; -fx-wrap-text: true; -fx-text-alignment: center;"/>
                            </VBox>

                            <!-- Formulaire Association -->
                            <VBox spacing="16" style="-fx-fill-height: true;">
                                <TextField fx:id="assocEmail"
                                           promptText="Email de l'association"
                                           prefHeight="44"
                                           style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-prompt-text-fill: #64748B;
                                                  -fx-background-radius: 12; -fx-padding: 0 14; -fx-font-size: 12;
                                                  -fx-border-color: #F59E0B; -fx-border-width: 1; -fx-border-radius: 12;"/>
                                <PasswordField fx:id="assocPassword"
                                               promptText="Mot de passe"
                                               prefHeight="44"
                                               style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-prompt-text-fill: #64748B;
                                                      -fx-background-radius: 12; -fx-padding: 0 14; -fx-font-size: 12;
                                                      -fx-border-color: #F59E0B; -fx-border-width: 1; -fx-border-radius: 12;"/>
                            </VBox>

                            <!-- Bouton Connexion -->
                            <Button text="Se connecter"
                                    onAction="#loginAssociation"
                                    prefWidth="260" prefHeight="44"
                                    style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: 700;
                                           -fx-background-radius: 12; -fx-font-size: 13; -fx-cursor: hand;">
                                <effect>
                                    <DropShadow color="#F59E0B66" radius="10"/>
                                </effect>
                            </Button>

                            <!-- Bouton Inscription -->
                            <VBox spacing="8">
                                <Label text="Première fois ?"
                                       style="-fx-text-fill: #94A3B8; -fx-font-size: 11; -fx-text-alignment: center;"/>
                                <Button text="Créer une association"
                                        onAction="#goToInscription"
                                        prefWidth="260" prefHeight="40"
                                        style="-fx-background-color: transparent;
                                               -fx-border-color: #F59E0B; -fx-border-width: 2;
                                               -fx-text-fill: #F59E0B; -fx-font-weight: 700;
                                               -fx-background-radius: 10; -fx-border-radius: 10;
                                               -fx-font-size: 12; -fx-cursor: hand;"/>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Footer -->
                    <HBox alignment="CENTER" spacing="24" style="-fx-padding: 20 0 0 0;">
                        <Label text="© 2025 Lightning EventManager"
                               style="-fx-text-fill: #475569; -fx-font-size: 11;"/>
                        <Separator orientation="VERTICAL" style="-fx-text-fill: #334155;"/>
                        <Label text="Plus de 800 associations marocaines nous font confiance"
                               style="-fx-text-fill: #475569; -fx-font-size: 11;"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>