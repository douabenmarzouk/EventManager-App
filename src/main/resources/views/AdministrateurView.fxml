<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.evenements.controller.AdministrateurController"
            style="-fx-background-color: #f9fafb;">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 2 0;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="🔐 Administration" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="24"/></font>
                </Label>
                <Label fx:id="niveauAccesLabel" text="Niveau: MODERATEUR"
                       style="-fx-background-color: #dbeafe; -fx-text-fill: #1e40af; -fx-background-radius: 4; -fx-padding: 4 12;">
                    <font><Font name="System Bold" size="12"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ Nouvel Admin" onAction="#onNouvelAdmin"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
            </HBox>
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
        </VBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20">
                <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

                <!-- FORMULAIRE ADMIN -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 20;">
                    <Label text="👤 Profil Administrateur" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="18"/></font>
                    </Label>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" prefWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="150" prefWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="ID :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="idField" editable="false"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"
                                   style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Niveau d'Accès :" GridPane.columnIndex="2" GridPane.rowIndex="0"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <ComboBox fx:id="niveauAccesCombo" GridPane.columnIndex="3" GridPane.rowIndex="0"
                                  maxWidth="Infinity"
                                  style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;"/>

                        <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="nomField" promptText="Nom"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Prénom :" GridPane.columnIndex="2" GridPane.rowIndex="1"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="prenomField" promptText="Prénom"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Email :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="emailField" promptText="admin@exemple.com"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Téléphone :" GridPane.columnIndex="2" GridPane.rowIndex="2"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="telephoneField" promptText="+216 XX XXX XXX"
                                   GridPane.columnIndex="3" GridPane.rowIndex="2"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Date Nomination :" GridPane.columnIndex="0" GridPane.rowIndex="3"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <DatePicker fx:id="dateNominationPicker" GridPane.columnIndex="1" GridPane.rowIndex="3"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;"/>

                        <Label text="Permissions :" GridPane.columnIndex="2" GridPane.rowIndex="3"
                               style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <Label fx:id="permissionsLabel" text="Permissions : -"
                               GridPane.columnIndex="3" GridPane.rowIndex="3"
                               style="-fx-text-fill: #6b7280;"/>
                    </GridPane>

                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="💾 Enregistrer" onAction="#onEnregistrer"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                        <Button text="🔄 Réinitialiser" onAction="#onReinitialiser"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- ACTIONS ADMIN -->
                <HBox spacing="20">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 15;">
                        <Label text="👤 Inscription Nouveau Membre" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="16"/></font>
                        </Label>
                        <TextField fx:id="newMembreNomField" promptText="Nom"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>
                        <TextField fx:id="newMembrePrenomField" promptText="Prénom"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>
                        <TextField fx:id="newMembreEmailField" promptText="Email"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>
                        <TextField fx:id="newMembreTelField" promptText="Téléphone"
                                   style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>
                        <Button text="✅ Inscrire Membre" onAction="#onInscrireMembre"
                                maxWidth="Infinity"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 15;">
                        <Label text="⚙️ Actions Administratives" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="16"/></font>
                        </Label>
                        <Button text="📊 Géstion Génerale "  onAction="#onGestionGenerale"
                                maxWidth="Infinity"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                        <Button text="🔐 Gérer Permissions" onAction="#onGererPermissions"
                                maxWidth="Infinity"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                    </VBox>
                </HBox>

                <!-- TABLE ADMINS -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="🔐 Liste des Administrateurs" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="18"/></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchAdminField" promptText="🔍 Rechercher..." prefWidth="250"
                                   style="-fx-background-color: #f3f4f6; -fx-border-color: transparent; -fx-background-radius: 20; -fx-padding: 8 15;"/>
                        <ComboBox fx:id="filtreNiveauCombo" promptText="Filtrer" prefWidth="180"
                                  style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    </HBox>

                    <TableView fx:id="administrateursTable" prefHeight="250"
                               style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="adminIdCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="adminNomCol" text="Nom" prefWidth="200"/>
                            <TableColumn fx:id="adminEmailCol" text="Email" prefWidth="220"/>
                            <TableColumn fx:id="adminTelCol" text="Téléphone" prefWidth="130"/>
                            <TableColumn fx:id="adminNiveauCol" text="Niveau" prefWidth="150"/>
                            <TableColumn fx:id="adminDateCol" text="Date" prefWidth="130"/>
                            <TableColumn fx:id="adminPermissionsCol" text="Permissions" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Label fx:id="totalAdminsLabel" text="Total : 0" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="14"/></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✏️ Modifier" onAction="#onModifierAdmin"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                        <Button text="🗑️ Supprimer" onAction="#onSupprimerAdmin"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- JOURNAL -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="📝 Journal d'Activité" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="18"/></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Actualiser" onAction="#onActualiserJournal"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                        <Button text="🗑️ Effacer" onAction="#onEffacerJournal"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="journalTable" prefHeight="200"
                               style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="journalDateCol" text="Date/Heure" prefWidth="150"/>
                            <TableColumn fx:id="journalAdminCol" text="Admin" prefWidth="180"/>
                            <TableColumn fx:id="journalActionCol" text="Action" prefWidth="200"/>
                            <TableColumn fx:id="journalDetailsCol" text="Détails" prefWidth="380"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- STATS -->
                <HBox spacing="20">
                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 15;">
                        <Label text="👥 Total Membres" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <Label fx:id="statMembresLabel" text="0" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28"/></font>
                        </Label>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 15;">
                        <Label text="⏳ En Attente" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <Label fx:id="statAttenteLabel" text="0" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28"/></font>
                        </Label>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 15;">
                        <Label text="✅ Validés" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <Label fx:id="statValidesLabel" text="0" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28"/></font>
                        </Label>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 15;">
                        <Label text="🔐 Admins" style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <Label fx:id="statAdminsLabel" text="0" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28"/></font>
                        </Label>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>