<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gestion.evenements.controller.LoginController"
           style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2);">

    <!-- LOGIN CARD -->
    <VBox spacing="25" alignment="CENTER" maxWidth="500" maxHeight="800"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 4);">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="🎉" style="-fx-font-size: 48px;"/>
            <Label text="Gestion d'Événements" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="28"/></font>
            </Label>
            <Label text="Connectez-vous pour continuer" style="-fx-text-fill: #6b7280;">
                <font><Font size="14"/></font>
            </Label>
        </VBox>

        <!-- SELECTION DU ROLE -->
        <VBox spacing="15" alignment="CENTER">
            <Label text="Vous êtes :" style="-fx-text-fill: #374151; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="14"/></font>
            </Label>

            <HBox spacing="15" alignment="CENTER">
                <ToggleButton fx:id="roleMembreBtn" text="👤&#10;Membre"
                              onAction="#onRoleSelected"
                              prefWidth="120" prefHeight="70"
                              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 2; -fx-text-fill: #374151; -fx-font-weight: 600; -fx-cursor: hand;"/>
                <ToggleButton fx:id="roleAdminBtn" text="🔐&#10;Admin"
                              onAction="#onRoleSelected"
                              prefWidth="120" prefHeight="70"
                              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 2; -fx-text-fill: #374151; -fx-font-weight: 600; -fx-cursor: hand;"/>
                <ToggleButton fx:id="roleAssociationBtn" text="🏛️&#10;Association"
                              onAction="#onRoleSelected"
                              prefWidth="120" prefHeight="70"
                              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 2; -fx-text-fill: #374151; -fx-font-weight: 600; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- FORMULAIRE -->
        <VBox spacing="15">
            <!-- Email -->
            <VBox spacing="5">
                <Label text="Email" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                <TextField fx:id="emailField" promptText="votre.email@exemple.com"
                           prefHeight="45"
                           style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 14px;"/>
            </VBox>

            <!-- Mot de passe -->
            <VBox spacing="5">
                <Label text="Mot de passe" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               prefHeight="45"
                               style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12; -fx-font-size: 14px;"/>
            </VBox>

            <!-- Options -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <CheckBox fx:id="rememberMeCheck" text="Se souvenir de moi"
                          style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Mot de passe oublié ?" onAction="#onForgotPassword"
                           style="-fx-text-fill: #2563eb; -fx-font-size: 13px;"/>
            </HBox>
        </VBox>

        <!-- MESSAGE ERREUR -->
        <Label fx:id="errorLabel" visible="false" wrapText="true" textAlignment="CENTER"
               style="-fx-text-fill: #dc2626; -fx-background-color: #fee2e2; -fx-padding: 10 15; -fx-background-radius: 6; -fx-font-size: 13px;"/>

        <!-- BOUTONS -->
        <VBox spacing="10">
            <Button fx:id="loginBtn" text="Se connecter" onAction="#onLogin"
                    prefHeight="45" maxWidth="Infinity"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 15px;">
            </Button>

            <Separator style="-fx-background-color: #e5e7eb;"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Pas encore de compte ?" style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
                <Hyperlink text="S'inscrire" onAction="#onSignup"
                           style="-fx-text-fill: #2563eb; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
    </VBox>

</StackPane>