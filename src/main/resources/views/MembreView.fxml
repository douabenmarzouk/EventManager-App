<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.evenements.controller.MembreController"
            style="-fx-background-color: #f9fafb;">

    <!-- HEADER -->
    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 2 0;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="👤 Gestion des Membres" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="24"/></font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="➕ Nouveau Membre" onAction="#onNouveauMembre"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
            </HBox>
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
        </VBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20">
                <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>

                <!-- FORMULAIRE MEMBRE -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 20;">
                    <Label text="📝 Informations du Membre" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="18"/></font>
                    </Label>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" prefWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="150" prefWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="N° Membre :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="numeroMembreField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #f3f4f6; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Statut :" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <ComboBox fx:id="statutCombo" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;"/>

                        <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="nomField" promptText="Nom" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Prénom :" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="prenomField" promptText="Prénom" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Email :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="emailField" promptText="email@exemple.com" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Téléphone :" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <TextField fx:id="telephoneField" promptText="+216 XX XXX XXX" GridPane.columnIndex="3" GridPane.rowIndex="2" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 12;"/>

                        <Label text="Cotisation Payée :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                        <CheckBox fx:id="cotisationPayeeCheck" text="Cotisation réglée" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>

                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="💾 Enregistrer" onAction="#onEnregistrer" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                        <Button text="🔄 Réinitialiser" onAction="#onReinitialiser" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- LISTE MEMBRES -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="👥 Tous les Membres" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="18"/></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="searchField" promptText="🔍 Rechercher..." prefWidth="250" style="-fx-background-color: #f3f4f6; -fx-border-color: transparent; -fx-background-radius: 20; -fx-padding: 8 15;"/>
                        <ComboBox fx:id="filtreStatutCombo" prefWidth="150" promptText="Filtrer par statut"
                                  style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    </HBox>

                    <TableView fx:id="membresTable" VBox.vgrow="ALWAYS" prefHeight="300" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="numeroCol" text="N° Membre" prefWidth="120"/>
                            <TableColumn fx:id="nomCol" text="Nom" prefWidth="200"/>
                            <TableColumn fx:id="emailCol" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="telephoneCol" text="Téléphone" prefWidth="120"/>
                            <TableColumn fx:id="statutCol" text="Statut" prefWidth="100"/>
                            <TableColumn fx:id="cotisationCol" text="Cotisation" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- SECTION FEEDBACKS -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 2); -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="💬 Feedbacks Récents" style="-fx-text-fill: #111827; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="18"/></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <TableView fx:id="feedbacksTable" prefHeight="200" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <columns>
                            <TableColumn fx:id="feedbackNoteCol" text="Note" prefWidth="80"/>
                            <TableColumn fx:id="feedbackCommentaireCol" text="Commentaire" prefWidth="400"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
