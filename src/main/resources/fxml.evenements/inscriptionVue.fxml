<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.evenements.view.evenements.InscriptionController">
    <top>
        <VBox style="-fx-background-color: #2ecc71; -fx-padding:
20;">

            <Label text="✍️ GESTION DES INSCRIPTIONS"

                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill:
white;"/>

            <Label text="Inscrire et gérer les participants aux
événements" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.4">
            <VBox spacing="15" style="-fx-padding: 20;

-fx-background-color: #e8f8f5;">

                <Label text="📝 FORMULAIRE D'INSCRIPTION"

                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill:
#27ae60;"/>

                <VBox spacing="5">
                    <Label text="Sélectionner un événement *"

                           style="-fx-font-weight: bold;"/>

                    <ComboBox fx:id="comboEvenement"
                              promptText="Choisir un événement" prefWidth="350"/>

                </VBox>
                <Separator/>
                <VBox spacing="5">
                    <Label text="Nom du participant *"

                           style="-fx-font-weight: bold;"/>

                    <TextField fx:id="txtNomParticipant"

                               promptText="Ex: Jean Dupont"/>

                </VBox>
                <VBox spacing="5">

                    <Label text="Email *" style="-fx-font-weight:

bold;"/>

                    <TextField fx:id="txtEmail" promptText="Ex:

jean.dupont@email.com"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Téléphone *"

                           style="-fx-font-weight: bold;"/>

                    <TextField fx:id="txtTelephone" promptText="Ex:

+216 XX XXX XXX"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Statut *" style="-fx-font-weight:

bold;"/>

                    <ComboBox fx:id="comboStatut"
                              promptText="Choisir un statut" prefWidth="350"/>

                </VBox>
                <VBox spacing="5">
                    <Label text="Notes (optionnel)"

                           style="-fx-font-weight: bold;"/>

                    <TextArea fx:id="txtNotes"

                              promptText="Informations supplémentaires..." prefRowCount="3"
                              wrapText="true"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER">
                    <Button fx:id="btnAjouter" text="➕ Inscrire"

                            onAction="#ajouterInscription"

                            style="-fx-background-color: #2ecc71;
-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10
20;"/>

                    <Button fx:id="btnModifier" text="✏️ Modifier"

                            onAction="#modifierInscription"

                            style="-fx-background-color: #f39c12;
-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10
20;"/>

                    <Button fx:id="btnAnnuler" text="🔄
Réinitialiser" onAction="#reinitialiserFormulaire"

                            style="-fx-background-color: #95a5a6;
-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10
20;"/>

                </HBox>

                <Label text="* Champs obligatoires"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;
-fx-font-style: italic;"/>

            </VBox>
            <VBox spacing="10" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📋 LISTE DES INSCRIPTIONS"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill:
#27ae60;"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Filtrer par événement:"/>
                    <ComboBox fx:id="comboFiltreEvenement"

                              promptText="Tous" prefWidth="200"
                              onAction="#filtrerInscriptions"/>

                    <Button fx:id="btnSupprimer" text="️

Supprimer" onAction="#supprimerInscription"

                            style="-fx-background-color: #e74c3c;

-fx-text-fill: white; -fx-font-weight: bold;"/>

                </HBox>
                <TableView fx:id="tableInscriptions"

                           VBox.vgrow="ALWAYS" onMouseClicked="#selectionnerInscription">

                    <columns>
                        <TableColumn fx:id="colId" text="ID"

                                     prefWidth="50"/>

                        <TableColumn fx:id="colParticipant"

                                     text="Participant" prefWidth="200"/>

                        <TableColumn fx:id="colEmail" text="Email"

                                     prefWidth="250"/>

                        <TableColumn fx:id="colTelephone"

                                     text="Téléphone" prefWidth="150"/>

                        <TableColumn fx:id="colDateInscription"

                                     text="Date d'inscription" prefWidth="150"/>

                        <TableColumn fx:id="colStatut"

                                     text="Statut" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune inscription. Utilisez
le formulaire pour en ajouter." style="-fx-text-fill: #7f8c8d;"/>

                    </placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
    <bottom>

        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-padding: 10; -fx-background-color: #e8f8f5;">

            <Label fx:id="lblStatus" text="Prêt"

                   style="-fx-text-fill: #7f8c8d;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNombreInscriptions" text="Total: 0
inscriptions" style="-fx-font-weight: bold; -fx-text-fill:
#27ae60;"/>

            <Button text="🔄 Actualiser" onAction="#actualiser"

                    style="-fx-font-weight: bold;"/>

            <Button fx:id="btnFermer" text="❌ Fermer"
                    onAction="#fermer" style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>